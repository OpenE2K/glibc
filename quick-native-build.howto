 To quickly build a typical glibc-2.35 for one of the modes available on e2k
(i.e. protected, 32- and 64-bit ones) in the native environment, configure it
in one of the following ways within a separate build directory and run `make':

glibc-2.35/configure --host=e2k128-mcst-linux-gnu --prefix=/usr CC="gcc -mptr128 -fasm-entries-first -fno-strict-aliasing -fno-ipa-attrs -fstack-arrays -U__NO_INLINE__ -masm-inline -Wno-builtin-functions-redefined -Wno-builtin-declaration-mismatch -Wno-error=invalid-builtin-arg -Wno-error=maybe-uninitialized -Wno-void-pointer-to-function-pointer-cast -Wno-int32-to-pointer-cast-protected" CXX="g++ -mptr128 -fasm-entries-first -fno-strict-aliasing -fno-ipa-attrs -fstack-arrays -U__NO_INLINE__ -masm-inline -Wno-builtin-functions-redefined -Wno-builtin-declaration-mismatch -Wno-error=invalid-builtin-arg -Wno-error=maybe-uninitialized -Wno-void-pointer-to-function-pointer-cast -Wno-int32-to-pointer-cast-protected" CFLAGS="-O3" CXXFLAGS="-O3" --enable-obsolete-rpc --enable-obsolete-nsl --enable-nscd

glibc-2.35/configure --host=e2k32-mcst-linux-gnu --prefix=/usr CC="gcc -mptr32 -fasm-entries-first -fno-strict-aliasing -fno-ipa-attrs -U__NO_INLINE__ -masm-inline -Wno-builtin-functions-redefined -Wno-builtin-declaration-mismatch -Wno-error=invalid-builtin-arg -Wno-error=maybe-uninitialized" CXX="g++ -mptr32 -fasm-entries-first -fno-strict-aliasing -fno-ipa-attrs -U__NO_INLINE__ -masm-inline -Wno-builtin-functions-redefined -Wno-builtin-declaration-mismatch -Wno-error=invalid-builtin-arg -Wno-error=maybe-uninitialized" CFLAGS="-O3" CXXFLAGS="-O3" --enable-obsolete-rpc --enable-obsolete-nsl --enable-nscd

glibc-2.35/configure --host=e2k64-mcst-linux-gnu --prefix=/usr CC="gcc -mptr64 -fasm-entries-first -fno-strict-aliasing -fno-ipa-attrs -U__NO_INLINE__ -masm-inline -Wno-builtin-functions-redefined -Wno-builtin-declaration-mismatch -Wno-error=invalid-builtin-arg -Wno-error=maybe-uninitialized" CXX="g++ -mptr64 -fasm-entries-first -fno-strict-aliasing -fno-ipa-attrs -U__NO_INLINE__ -masm-inline -Wno-builtin-functions-redefined -Wno-builtin-declaration-mismatch -Wno-error=invalid-builtin-arg -Wno-error=maybe-uninitialized" CFLAGS="-O3" CXXFLAGS="-O3" --enable-obsolete-rpc --enable-obsolete-nsl --enable-nscd
